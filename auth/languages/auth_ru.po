msgid "Database error."
msgstr "Ошибка базы данных."

msgid "Invalid account activation link"
msgstr "Неверная ссылка для активации учетной записи"

msgid "Account is already activated."
msgstr "Учетная запись уже была активирована ранее."

msgid "Session error"
msgstr "Ошибка сессии"

msgid "Password is too short."
msgstr "Пароль слишком короткий."

msgid "Password is too weak."
msgstr "Пароль слишком ненадежный."

msgid "Password has been change."
msgstr "Пароль установлен."

#, php-format
msgid ""
"Account %s has been activated. Please set a password for your account. You "
"may set the password later by following the link <a href=\"%s\">Forgot your "
"password</a>."
msgstr ""
"Учетная запись %s активирована. Пожалуйста, установите пароль входа. Пароль "
"можно установить позже по ссылке <a href=\"%s\">«Зыбыли пароль»</a>."

#, php-format
msgid "%s - Forgot your password?"
msgstr "%s — Забыли пароль?"

msgid "Forgot password?"
msgstr "Забыли пароль?"

msgid ""
"Enter the email address associated with your account and we will send you a "
"link to reset your password."
msgstr ""
"Чтобы сбросить пароль, введите email, с помощью которого вы входили на сайт."

msgid "Request Password Reset"
msgstr "Запрос сброса пароля"

msgid "← Sign in"
msgstr "← Войти"

#, php-format
msgid "%s - Sign in"
msgstr "%s — Войти"

msgid "Sing in"
msgstr "Войти"

msgid "Password"
msgstr "Пароль"

msgid "Remember me"
msgstr "Запомнить"

#, php-format
msgid "%s - Set new password"
msgstr "%s — Установка нового пароля"

msgid "Set new password"
msgstr "Установка нового пароля"

msgid "New password"
msgstr "Новый пароль"

msgid "Change password"
msgstr "Изменить пароль"
