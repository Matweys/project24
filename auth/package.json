{
  "devDependencies": {
    "bootstrap": "^5.2.0",
    "folder-hash": "^4.0.0",
    "nodemon": "^3.0.1",
    "npm-run-all": "^4.1.5",
    "sass": "^1.68.0",
    "terser": "^5.14.2"
  },
  "private": true,
  "scripts": {
    "compile": "run-p --aggregate-output compile:*",
    "compile:main.css": "sass --style compressed --no-source-map --no-error-css scss/main.scss:static/main.css",
    "compile:main.js": "terser --compress passes=2 --mangle --comments \"/^!/\" --output static/main.js -- js/language_switch.js",
    "update_asset_version": "node update_assets_version.js",
    "watch": "nodemon --ext css,gif,jpg,js,png,scss,svg,webp --exec \"run-s compile update_asset_version\" --ignore static/"
  }
}
